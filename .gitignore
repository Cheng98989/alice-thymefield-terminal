# Local state: whether fastfetch runs at startup on THIS machine.
# Tracking it would mean every toggle shows up as a pending change.
fastfetch/autostart.on

# Backups of your own Windows Terminal settings.json. Machine-specific and
# full of local paths, profile GUIDs and WSL distros: never publish them.
windows-terminal/settings.json.original
windows-terminal/settings.json.backup

# Appended by install.ps1 when it finds a pre-existing PowerShell profile.
*.backup

__pycache__/
*.pyc


# Written by "fastfetch reset" before it replaces the live config.
fastfetch/config.jsonc.backup

# Written by "fastfetch reset" before it replaces the live config.
fastfetch/config.jsonc.backup
